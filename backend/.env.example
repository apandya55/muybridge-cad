# Runtime
ENVIRONMENT=development
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
# Limit concurrent work and request/artifact retention.
MAX_ACTIVE_JOBS=2
MAX_PROMPT_CHARS=8000
MAX_CODE_CHARS=100000
MAX_JOBS=1000
# Optional persistent artifact directory. Keep it outside the public web root.
# JOBS_DIR=/var/lib/muybridge/jobs
# Max compile->check->critique->fix cycles before giving up (default 3)
CRITIC_MAX_ITERATIONS=3
# Per-compile subprocess timeout in seconds (default 30)
COMPILE_TIMEOUT_S=30
# Minimum acceptable wall thickness in mm (default 1.0)
MIN_WALL_THICKNESS_MM=1.0
# Bounding-box tolerance in mm when requested_dims provided (default 0.5)
BBOX_TOLERANCE_MM=0.5
# Number of wall-thickness sample rays (default 256)
WALL_THICKNESS_SAMPLES=256

# Review model
# LLM_PROVIDER accepts "anthropic" or "openai".
LLM_PROVIDER=anthropic
# Model name sent to the provider.
LLM_MODEL=claude-sonnet-5-5
# API key. Falls back to ANTHROPIC_API_KEY when provider is anthropic.
LLM_API_KEY=
ANTHROPIC_API_KEY=
# Base URL for an OpenAI-compatible endpoint.
LLM_BASE_URL=
# Maximum response tokens.
LLM_MAX_TOKENS=4096

# OpenSCAD
# The binary is found on PATH unless this is set.
# OPENSCAD_BIN=/usr/local/bin/openscad
